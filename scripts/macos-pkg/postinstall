#!/bin/bash
#
# LiteLLM Relay package postinstall.
#
# Runs as root at install time. Relay is a per-user proxy (a user LaunchAgent,
# plus login-keychain CA trust when the managed config captures payloads), so
# this installs it for the active console user using the prebuilt binary; no
# Rust/cargo on the endpoint.
set -euo pipefail

PAYLOAD="/usr/local/litellm-relay"
INSTALLER="$PAYLOAD/install.sh"
BINARY="$PAYLOAD/litellm-relay"
CONFIG="$PAYLOAD/config.yaml"

console_user="$(/usr/bin/stat -f%Su /dev/console 2>/dev/null || echo root)"

if [[ -z "$console_user" || "$console_user" == "root" || "$console_user" == "loginwindow" || "$console_user" == "_mbsetupuser" ]]; then
  echo "No user is logged in at the console, so Relay was not installed for anyone." >&2
  echo "The payload is staged at $PAYLOAD; this install reports a failure so the MDM runs it again once a user is logged in." >&2
  exit 1
fi

console_uid="$(/usr/bin/id -u "$console_user")"

args=(--background --skip-setup --prebuilt-binary "$BINARY")
if [[ -f "$CONFIG" ]]; then
  seed_dir="$(/usr/bin/mktemp -d /private/tmp/litellm-relay-config.XXXXXX)"
  trap '/bin/rm -rf "$seed_dir"' EXIT
  /usr/bin/install -m 0600 -o "$console_user" "$CONFIG" "$seed_dir/config.yaml"
  /bin/chmod 0711 "$seed_dir"
  args+=(--config-file "$seed_dir/config.yaml")
fi

echo "Installing LiteLLM Relay for console user: $console_user (uid $console_uid)"

# Run inside the user's GUI session so launchctl bootstrap gui/<uid> works.
/bin/launchctl asuser "$console_uid" /usr/bin/sudo -H -u "$console_user" \
  /bin/bash "$INSTALLER" "${args[@]}"

echo "LiteLLM Relay install complete for $console_user."
exit 0
