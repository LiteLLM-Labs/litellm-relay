# Managed LiteLLM Relay config for MDM deployment.
#
# Deploy this file to each device and point the installer at it with
# --config-file (or RELAY_MANAGED_CONFIG). The installer copies it to
# ~/.litellm-relay/config.yaml with 0600 permissions and Relay reads it
# when the LaunchAgent starts. Unset sections fall back to Relay defaults.
#
# Prefer browser SSO for developer Gateway auth. Only set gateway.api_key
# here if your rollout uses a shared, non-user Gateway key, since this file
# lands on every managed device.

relay:
  host: 127.0.0.1
  port: 4142

gateway:
  # Your LiteLLM AI Gateway base URL. With an environments list below, this
  # is the current environment and a switch rewrites it.
  url: https://litellm-gateway.your-company.com
  # api_key: sk-...  # optional; omit to use per-user browser SSO
  # team: eng-platform  # the team the daemon mints keys for; a team switch writes it

# The Gateways a developer can switch between from RelayBar or an agent; the
# one whose url equals gateway.url is current. All share the idp section. An
# entry's team is that Gateway's default team until the developer picks one.
# environments:
#   - name: prod
#     url: https://litellm-gateway.your-company.com
#     team: eng-platform
#   - name: uat
#     url: https://litellm-gateway-uat.your-company.com
#   - name: test
#     url: https://litellm-gateway-test.your-company.com

# Org IdP for the per-user OIDC sign-in (authorization code plus PKCE) that
# Claude Code, Codex, and Claude Desktop use to reach the Gateway. Register
# Relay as a public client with the loopback redirect URI
# http://127.0.0.1/callback and enable ID tokens for it.
idp:
  issuer: https://login.microsoftonline.com/<tenant-id>/v2.0
  client_id: <app-client-id>
  # scopes: openid profile email offline_access  # optional; discovery trims the defaults
  # redirect_port: 8765  # optional; the default is a random loopback port

# Shadow-AI interception (Notion AI, Perplexity, etc.) routed to the Gateway.
shadow:
  enabled: true
  model: gpt-4o-mini
  min_interval_seconds: 60

# Metadata-only by default. Enable payloads only if your policy allows it;
# Relay still redacts headers and never logs cookies or authorization.
capture:
  payloads: false
  payload_preview_bytes: 0
  payload_body_bytes: 0

timeouts:
  request_seconds: 10.0

# Which processes the Relay daemon hands a Gateway credential to (macOS).
# It checks the code signature of the asking process and up to four of its
# ancestors: the signing identifier plus the Apple Team ID on the leaf
# certificate. Setting this list replaces the built-in defaults shown here,
# so repeat every client you keep, each with its team_id: an entry without one
# is ignored, since an identifier alone is satisfied by any ad hoc signature.
credential:
  # allowed_callers:
  #   - identifier: com.anthropic.claudefordesktop
  #     team_id: Q6L2SF6YDW
  #   - identifier: com.anthropic.claudefordesktop.helper
  #     team_id: Q6L2SF6YDW
  #   - identifier: com.anthropic.claude-code
  #     team_id: Q6L2SF6YDW
  #   - identifier: codex
  #     team_id: 2DC432GLL2

# The MCP relay (`relay mcp`). The daemon marks a Gateway MCP tool as allow
# (runs with no prompt) only when its name shows it is read-only, and as ask
# (the user confirms each call) otherwise. `allow` lists exact, case-sensitive
# Gateway tool names (`<server>-<tool>`) that run with no prompt anyway; it
# has no wildcards and never hides or denies a tool. `max_concurrent_calls`
# caps the tool calls in flight across every client on this device; 0 or a
# missing key means 16. `tool_prefix_separator` is the text between a server's
# name and a tool's own name in the Gateway's tool names (the Gateway's
# MCP_TOOL_PREFIX_SEPARATOR); a missing or empty key means `-`. A name the
# separator does not split lands on the server `ungrouped`, where every tool
# asks unless `allow` names it.
mcp:
  # allow:
  #   - github-create_issue
  #   - jira-add_comment
  # max_concurrent_calls: 16
  # tool_prefix_separator: "-"
